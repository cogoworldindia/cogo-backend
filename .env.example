# ================================================================
# Copy to .env and fill in every CHANGE_ME value before running.
# Secrets (passwords, keys) should also be placed in .env.secrets
# (copy .env.secrets.example → .env.secrets).
# ================================================================

# --- Environment ---
ENV=development
DEBUG=true
APP_PORT=8000

# --- Database components (used to construct DATABASE_URL in docker-compose) ---
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
AUTH_DB=authdb
USER_DB=userdb

# --- Redis ---
REDIS_URL=redis://host.docker.internal:6379/0

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REDIS_PREFIX=refresh_token:

# --- Internal service URLs (Docker DNS — used inside containers) ---
AUTH_SERVICE_URL=http://auth-service:8000/v1/auth
USER_SERVICE_URL=http://user-service:8000/v1/users
EMAIL_SERVICE_URL=http://mail-service:8082/mail/send

# --- Mail service ---
MAILHOST=smtp.gmail.com
MAILPORT=587
MAIL_SERVER_PORT=8082

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=services/auth/app/core/credentials/cogo-d1d73-firebase-adminsdk-fbsvc-35c5cef711.json
