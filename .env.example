# ================================================================
# Non-secret settings for the local stack. Copy to .env (`make secrets` does it).
# Secrets live in .env.secrets (generated by `make secrets`) and secrets/ (key files).
# ================================================================

# --- Runtime ---
ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Postgres (database-per-service; each service has its own login role) ---
POSTGRES_USER=postgres
AUTH_DB=authdb
AUTH_DB_USER=auth_svc
USER_DB=userdb
USER_DB_USER=user_svc
JOURNEY_DB=journeydb
JOURNEY_DB_USER=journey_svc
SOCIAL_DB=socialdb
SOCIAL_DB_USER=social_svc

# --- RabbitMQ ---
RABBITMQ_USER=cogo

# --- Tokens ---
JWT_ISSUER=cogo-auth
JWT_AUDIENCE=cogo-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Google sign-in (Firebase Auth). Only the project id is needed; leave empty to disable.
FIREBASE_PROJECT_ID=cogo-d1d73

# --- Gateway ---
# JSON list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Proxies whose X-Forwarded-For is trusted (your load balancer in production).
GATEWAY_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Places (journey-service): mock (fixtures) or google (needs GOOGLE_PLACES_API_KEY in .env.secrets)
PLACES_PROVIDER=mock

# --- Media: S3-compatible store. Dev uses RustFS at http://localhost:9000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/cogo-media

# --- Email (dev: Mailpit catches everything at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
MAIL_FROM=CoGo <no-reply@cogo.app>

# --- Tracing: set to http://jaeger:4318 and run `make obs-up` to collect traces ---
OTEL_EXPORTER_OTLP_ENDPOINT=
