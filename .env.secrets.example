# ================================================================
# Copy to .env.secrets — NEVER commit this file.
# These values are injected into containers alongside .env.
# They also override any matching vars already in .env.
# ================================================================

# --- Database password (used in DATABASE_URL constructed by docker-compose) ---
POSTGRES_PASSWORD=CHANGE_ME

# --- JWT signing secret (generate: openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_ME

# --- Mail credentials ---
MAILUSERNAME=CHANGE_ME@gmail.com
MAILPASSWORD=CHANGE_ME
