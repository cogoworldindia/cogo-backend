# ================================================================
# Secrets for the local stack. NEVER commit .env.secrets.
# `make secrets` creates it with random values; existing values are kept.
# Use URL-safe values (hex): passwords are embedded in connection URLs.
# ================================================================
POSTGRES_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
JOURNEY_DB_PASSWORD=CHANGE_ME
SOCIAL_DB_PASSWORD=CHANGE_ME
CHAT_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
OTP_HMAC_KEY=CHANGE_ME
KYC_OTP_HMAC_KEY=CHANGE_ME
KYC_MOCK_WEBHOOK_SECRET=CHANGE_ME
ADMIN_DB_PASSWORD=CHANGE_ME
ADMIN_TOTP_ENCRYPTION_KEY=CHANGE_ME
# Development only: the first admin console account (ADMIN_BOOTSTRAP_EMAIL in .env)
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
ADMIN_BOOTSTRAP_TOTP_SECRET=CHANGE_ME
CURSOR_SECRET=CHANGE_ME
MEDIA_ACCESS_KEY=CHANGE_ME
MEDIA_SECRET_KEY=CHANGE_ME
GOOGLE_PLACES_API_KEY=

# Real SMTP relay (production / staging only; dev uses Mailpit without auth)
SMTP_USERNAME=
SMTP_PASSWORD=
