# ================================================================
# Secrets for the local stack. NEVER commit .env.secrets.
# `make secrets` creates it with random values; existing values are kept.
# Use URL-safe values (hex): passwords are embedded in connection URLs.
# ================================================================
POSTGRES_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
OTP_HMAC_KEY=CHANGE_ME

# Real SMTP relay (production / staging only; dev uses Mailpit without auth)
SMTP_USERNAME=
SMTP_PASSWORD=
