    },
    "sender_id": {
      "format": "uuid",
      "title": "Sender Id",
      "type": "string"
    },
    "target_journey_id": {
      "format": "uuid",
      "title": "Target Journey Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "sender_id",
    "receiver",
    "target_journey_id",
    "conversation_id"
