      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "receiver": {
      "$ref": "#/$defs/UserRef"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "route_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
