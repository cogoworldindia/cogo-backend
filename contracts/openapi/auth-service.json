  "info": {
    "title": "CoGo Auth Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/email/send": {
      "post": {
        "description": "Email a 6-digit code. The response is identical whether or not an account exists.",
        "operationId": "send_code_v1_auth_email_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_EmailSendResponse_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Code",
        "tags": [
          "email"
        ]
      }
    },
    "/v1/auth/email/verify": {
      "post": {
        "operationId": "verify_code_v1_auth_email_verify_post",
        "requestBody": {
          "content": {
