  "info": {
    "title": "CoGo Notification Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/me/devices": {
      "delete": {
        "description": "On logout. Only your own token can be removed.",
        "operationId": "unregister_device_v1_me_devices_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRemove"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unregister Device",
        "tags": [
          "notifications"
        ]
      },
      "post": {
        "description": "Idempotent. A token belongs to one user: signing in as someone else on the same phone\nmoves it, so pushes never go to the previous account.",
        "operationId": "register_device_v1_me_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Device",
        "tags": [
          "notifications"
        ]
      }
    },
    "/v1/me/devices/test-pushes": {
      "get": {
        "description": "Dev/test only (PUSH_PROVIDER=mock): the pushes the mock \"sent\" to you, newest first.",
        "operationId": "test_pushes_v1_me_devices_test_pushes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_dict_str__Any___"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Test Pushes",
        "tags": [
          "notifications"
        ]
      }
    },
    "/v1/me/notification-prefs": {
      "get": {
        "operationId": "get_prefs_v1_me_notification_prefs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_PrefsOut_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Prefs",
        "tags": [
          "notifications"
        ]
      },
      "put": {
        "operationId": "put_prefs_v1_me_notification_prefs_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrefsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_PrefsOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Prefs",
        "tags": [
          "notifications"
        ]
      }
    }
  }
}
